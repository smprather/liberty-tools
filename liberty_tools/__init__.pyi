        self,
        *,
        cell: str | None = None,
        pin: str | None = None,
        related_pin: str | None = None,
        related_pg_pin: str | None = None,
        when: str | None = None,
        table: str | None = None,
    ) -> list[dict[str, Any]]: ...
    def to_polars(
        self,
        kind: Literal["timing", "power"] = "timing",
        **filters: Any,
    ) -> Any: ...


class BooleanExpression:
    def __init__(self, source: str) -> None: ...
    @property
    def source(self) -> str: ...
    @property
    def raw(self) -> str: ...
    @property
    def variables(self) -> list[str]: ...
    def minterms(self) -> list[str]: ...
    def canonical(self) -> str: ...
    def minimized(self) -> str: ...
    def eval(self, mapping: dict[str, bool] | None = ..., **kwargs: bool) -> bool: ...
    def implies(self, other: BooleanExpression) -> bool: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...


class Cell:
